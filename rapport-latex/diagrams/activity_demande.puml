@startuml

skinparam dpi 150
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 13
skinparam ArrowColor #14507A
skinparam roundCorner 6

skinparam activity {
  BackgroundColor #EAF3FA
  BorderColor #1B6CA8
  DiamondBackgroundColor #DCEAF5
  DiamondBorderColor #14507A
}
skinparam swimlane {
  BorderColor #1B6CA8
  TitleBackgroundColor #EAF3FA
}

|Utilisateur|
start
:Soumettre une demande de modification;
:Enregistrer la demande\n(statut EN_ATTENTE);
:Notifier le directeur commercial;

|Directeur commercial|
:Consulter la demande;
if (Décision ?) then (Approuver)
  :Statut = EN_COURS;
  :Notifier l'administrateur;
  |Administrateur|
  :Exécuter la demande;
  :Appliquer la modification en base;
  :Statut = EFFECTUE;
else (Refuser)
  |Directeur commercial|
  :Statut = REFUSE;
  :Enregistrer le commentaire;
endif

|Administrateur|
:Journaliser l'action (audit);

|Utilisateur|
:Recevoir la notification;
stop
@enduml
