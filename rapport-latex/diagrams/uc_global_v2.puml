@startuml
' ============ Diagramme de cas d'utilisation global — BTK ============
skinparam dpi 170
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 15
skinparam roundCorner 8
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ArrowColor #14507A
skinparam ArrowThickness 1.1
skinparam actorBorderColor #14507A
skinparam actorBackgroundColor #EAF3FA
skinparam actorFontStyle bold
skinparam actorFontSize 15
skinparam usecaseBackgroundColor #EAF3FA
skinparam usecaseBorderColor #1B6CA8
skinparam usecaseBorderThickness 1.2
skinparam usecaseFontSize 14
skinparam rectangleBackgroundColor #FBFCFE
skinparam rectangleBorderColor #1B6CA8
skinparam rectangleFontColor #14507A
skinparam rectangleFontStyle bold
skinparam rectangleFontSize 16
skinparam nodesep 22
skinparam ranksep 210

actor "Administrateur" as ADM
actor "Directeur commercial" as DIR
actor "Utilisateur" as USR

rectangle "Application de gestion des agences bancaires" {
  ' --- cas propres à l'administrateur ---
  usecase "Gérer les rôles et\nles droits d'accès" as UC01
  usecase "Gérer les agences" as UC02
  usecase "Gérer les clients" as UC03
  usecase "Consulter le\njournal d'audit" as UC04
  usecase "Alimenter le\ndatamart (ETL)" as UC05
  usecase "Segmenter\nles agences" as UC06
  ' --- cas partagés avec le directeur commercial ---
  usecase "Gérer les employés" as UC07
  usecase "Suivre les objectifs\ncommerciaux" as UC08
  usecase "Valider une\ndemande" as UC09
  usecase "Consulter le\ntableau de bord" as UC10
  ' --- cas partagés avec l'utilisateur ---
  usecase "Soumettre une\ndemande" as UC11
  usecase "Pointer la présence\n(arrivée / départ)" as UC12
  usecase "Recevoir des\nnotifications" as UC13
  ' --- cas inclus par tous ---
  usecase "S'authentifier" as UC00
}

' ===================== Administrateur : les 13 cas =====================
ADM --> UC01
ADM --> UC02
ADM --> UC03
ADM --> UC04
ADM --> UC05
ADM --> UC06
ADM --> UC07
ADM --> UC08
ADM --> UC09
ADM --> UC10
ADM --> UC11
ADM --> UC12
ADM --> UC13

' ===================== Directeur commercial : 5 cas =====================
DIR --> UC07 : consultation
DIR --> UC08
DIR --> UC09
DIR --> UC10
DIR --> UC11

' ===================== Utilisateur : 3 cas =====================
USR --> UC11
USR --> UC12
USR --> UC13

' ===================== Relations «include» =====================
UC01 ..> UC00 : <<include>>
UC02 ..> UC00 : <<include>>
UC03 ..> UC00 : <<include>>
UC04 ..> UC00 : <<include>>
UC05 ..> UC00 : <<include>>
UC06 ..> UC00 : <<include>>
UC07 ..> UC00 : <<include>>
UC08 ..> UC00 : <<include>>
UC09 ..> UC00 : <<include>>
UC10 ..> UC00 : <<include>>
UC11 ..> UC00 : <<include>>
UC12 ..> UC00 : <<include>>
UC13 ..> UC00 : <<include>>
@enduml
