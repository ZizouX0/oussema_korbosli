@startuml

skinparam dpi 150
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 13
skinparam ArrowColor #14507A
skinparam roundCorner 6

skinparam sequence {
  ArrowColor #14507A
  LifeLineBorderColor #1B6CA8
  ParticipantBorderColor #1B6CA8
  ParticipantBackgroundColor #EAF3FA
  ActorBorderColor #14507A
}
actor "Directeur\ncommercial" as DIR
actor "Administrateur" as ADM
participant "GestionModifications\nServlet" as SRV
participant "DemandeModification\nService (EJB)" as SVC
participant "Notification /\nJournalService (EJB)" as JRN
participant "EntityManager" as EM
database "Oracle" as DB

== 1. Approbation par le directeur commercial ==
DIR -> SRV : POST /gestion-demandes\n(id, approve, commentaire)
activate SRV
SRV -> SVC : approveRequest(id, commentaire)
activate SVC
SVC -> EM : find(DemandeModification, id)
EM -> DB : SELECT
alt statut = EN_ATTENTE
  SVC -> SVC : statut = EN_COURS
  SVC -> EM : merge(demande)
  EM -> DB : UPDATE
  SVC -> JRN : notifier l'administrateur\n+ journaliser
else refus
  SVC -> SVC : statut = REFUSE
  SVC -> JRN : notifier le demandeur\n+ journaliser
end
SVC --> SRV : succès
deactivate SVC
SRV --> DIR : confirmation
deactivate SRV

== 2. Exécution par l'administrateur ==
ADM -> SRV : POST /gestion-demandes (id, execute)
activate SRV
SRV -> SVC : executeRequest(id)
activate SVC
SVC -> EM : find(DemandeModification, id)
alt statut = EN_COURS
  SVC -> SVC : appliquer la modification\n(nom ou email)
  SVC -> EM : merge(Utilisateur) ; statut = EFFECTUE
  EM -> DB : UPDATE
  SVC -> JRN : journaliser + notifier le demandeur
end
SVC --> SRV : succès
deactivate SVC
SRV --> ADM : confirmation
deactivate SRV
@enduml
