<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="default" transaction-type="JTA">
        <description>Oracle BTK persistence unit</description>
        <jta-data-source>java:/OracleDS</jta-data-source>

        <class>entity.Utilisateur</class>
        <class>entity.Agence</class>
        <class>entity.DemandeAgence</class>
        <class>entity.JournalAction</class>
        <class>entity.Notification</class>
        <class>entity.Banque</class>


        <class>entity.BClient</class>
        <class>entity.Client</class>
        <class>entity.Gestionnaire</class>
        <class>entity.Objectif</class>
        <class>entity.BtkClient</class>
        <class>entity.DemandeEmploye</class>
        <class>entity.DemandeClient</class>
        <class>entity.DemandeModification</class>
        <class>entity.SecurityUser</class>
        <class>entity.Pointage</class>

        <!--
            Les paramètres de connexion (URL, utilisateur, mot de passe) ne sont
            PAS déclarés ici : l'unité de persistance est en transaction-type
            JTA, donc le serveur fournit la connexion via la datasource
            java:/OracleDS déclarée ci-dessus. Les propriétés
            jakarta.persistence.jdbc.* seraient ignorées à l'exécution, et une
            valeur périmée y induit en erreur lors du dépannage.

            La connexion se change côté WildFly :
                /subsystem=datasources/data-source=OracleDS:write-attribute(name=user-name,value="...")
                /subsystem=datasources/data-source=OracleDS:write-attribute(name=password,value="...")
                reload
            Voir tools/DEPANNAGE_ORACLE_WILDFLY.md
        -->
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.OracleDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
        </properties>
    </persistence-unit>

</persistence>